    "input_boolean": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on"}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off"}, "toggle": {"service": "toggle", "slot": "power", "power": "toggle"}, "pulse": {"service": "turn_on", "slot": "power", "value": "seconds", "read": "power", "want": "on", "power": "on"}},
    "light": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on"}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off"}, "toggle": {"service": "toggle", "slot": "power", "power": "toggle"}, "brightness": {"value": "percent", "restore": true, "service": "turn_on", "field": "brightness_pct", "zero": "turn_off", "read": "brightness", "slot": "power", "power": "value", "beyond": {"attr": "supported_color_modes", "not": ["onoff"]}}, "pulse": {"service": "turn_on", "slot": "power", "value": "seconds", "read": "power", "want": "on", "power": "on"}},
    "fan": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on", "features": [32]}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off", "features": [16]}, "toggle": {"service": "toggle", "slot": "power", "power": "toggle", "features": [16, 32]}, "speed": {"value": "percent", "restore": true, "service": "set_percentage", "field": "percentage", "zero": "turn_off", "read": "percentage", "slot": "power", "power": "value", "features": [1]}, "preset": {"service": "set_preset_mode", "field": "preset_mode", "value": "option", "options": "preset_modes", "read": "preset_mode", "slot": "preset", "restore": true, "power": "on", "features": [1, 8]}},
    "climate": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on", "features": [256]}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off", "features": [128]}, "setpoint": {"service": "set_temperature", "field": "temperature", "value": "setpoint", "bounds": ["min_temp", "max_temp"], "step": "target_temp_step", "read": "temperature", "slot": "setpoint", "restore": true, "features": [1]}, "mode": {"service": "set_hvac_mode", "field": "hvac_mode", "value": "option", "options": "hvac_modes", "read": "state", "slot": "power", "restore": true, "power": "value"}, "preset": {"service": "set_preset_mode", "field": "preset_mode", "value": "option", "options": "preset_modes", "read": "preset_mode", "slot": "preset", "restore": true, "features": [16]}, "fan_mode": {"service": "set_fan_mode", "field": "fan_mode", "value": "option", "options": "fan_modes", "read": "fan_mode", "slot": "fan_mode", "restore": true, "features": [8]}},
    "cover": {"open": {"service": "open_cover", "slot": "position", "read": "position", "want": 100, "opposite": "close", "features": [1]}, "close": {"service": "close_cover", "slot": "position", "read": "position", "want": 0, "opposite": "open", "features": [2]}, "stop": {"service": "stop_cover", "slot": "position", "features": [8]}, "toggle": {"service": "toggle", "slot": "position", "features": [3]}, "position": {"value": "percent", "restore": true, "service": "set_cover_position", "field": "position", "zero": "close_cover", "full": "open_cover", "read": "position", "slot": "position", "features": [4]}, "tilt": {"value": "percent", "restore": true, "service": "set_cover_tilt_position", "field": "tilt_position", "read": "current_tilt_position", "slot": "tilt", "features": [128]}},
    "valve": {"close": {"service": "close_valve", "slot": "power", "read": "closed", "want": "closed"}},
    "number": {"value": {"service": "set_value", "field": "value", "value": "number", "bounds": ["min", "max"], "step": "step", "read": "state", "slot": "value", "restore": true}},
    "input_number": {"value": {"service": "set_value", "field": "value", "value": "number", "bounds": ["min", "max"], "step": "step", "read": "state", "slot": "value", "restore": true}},
    "select": {"option": {"service": "select_option", "field": "option", "value": "option", "options": "options", "read": "state", "slot": "value", "restore": true}},
    "input_select": {"option": {"service": "select_option", "field": "option", "value": "option", "options": "options", "read": "state", "slot": "value", "restore": true}},
    "button": {"press": {"service": "press", "slot": "press"}},
    "input_button": {"press": {"service": "press", "slot": "press"}},
    "scene": {"scene": {"service": "turn_on", "slot": "scene"}},
    "script": {"run": {"service": "turn_on", "slot": "run"}},
    "media_player": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on", "features": [128]}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off", "features": [256]}, "play": {"service": "media_play", "slot": "play", "read": "state", "want": "playing", "opposite": "pause", "features": [16384]}, "pause": {"service": "media_pause", "slot": "play", "read": "state", "want": "paused", "opposite": "play", "features": [1]}, "stop": {"service": "media_stop", "slot": "play", "features": [4096]}, "volume": {"value": "percent", "restore": true, "service": "volume_set", "field": "volume_level", "scale": 0.01, "read": "volume", "slot": "volume", "features": [4]}, "source": {"service": "select_source", "field": "source", "value": "option", "options": "source_list", "read": "source", "slot": "source", "restore": true, "features": [2048]}},
    "humidifier": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on"}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off"}, "humidity": {"service": "set_humidity", "field": "humidity", "value": "number", "bounds": ["min_humidity", "max_humidity"], "read": "humidity", "slot": "humidity", "restore": true}, "mode": {"service": "set_mode", "field": "mode", "value": "option", "options": "available_modes", "read": "mode", "slot": "mode", "restore": true, "features": [1]}},
    "water_heater": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on", "features": [8]}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off", "features": [8]}, "setpoint": {"service": "set_temperature", "field": "temperature", "value": "setpoint", "bounds": ["min_temp", "max_temp"], "step": "target_temp_step", "read": "temperature", "slot": "setpoint", "restore": true, "features": [1]}, "operation": {"service": "set_operation_mode", "field": "operation_mode", "value": "option", "options": "operation_list", "read": "operation_mode", "slot": "operation", "restore": true, "features": [2]}},
    "siren": {"on": {"service": "turn_on", "slot": "power", "read": "power", "want": "on", "opposite": "off", "power": "on", "features": [1]}, "off": {"service": "turn_off", "slot": "power", "read": "power", "want": "off", "opposite": "on", "power": "off", "features": [2]}},
    "text": {"text": {"service": "set_value", "field": "value", "value": "text", "bounds": ["min", "max"], "read": "state", "slot": "value", "restore": true}},
    "input_text": {"text": {"service": "set_value", "field": "value", "value": "text", "bounds": ["min", "max"], "read": "state", "slot": "value", "restore": true}},
    "time": {"time": {"service": "set_value", "field": "time", "value": "time", "read": "state", "slot": "value", "restore": true}},
    "date": {"date": {"service": "set_value", "field": "date", "value": "date", "read": "state", "slot": "value", "restore": true}},
    "datetime": {"datetime": {"service": "set_value", "field": "datetime", "value": "datetime", "read": "state", "slot": "value", "restore": true}},
    "input_datetime": {"time": {"service": "set_datetime", "field": "time", "value": "time", "read": "state", "slot": "value", "restore": true, "needs": ["has_time"]}, "date": {"service": "set_datetime", "field": "date", "value": "date", "read": "state", "slot": "value", "restore": true, "needs": ["has_date"]}, "datetime": {"service": "set_datetime", "field": "datetime", "value": "datetime", "read": "state", "slot": "value", "restore": true, "needs": ["has_date", "has_time"]}},
    "notify": {"message": {"service": "send_message", "field": "message", "value": "text", "slot": "message"}}
  },
  "actions": {"pulse_s": [1, 600], "pulse_default_s": 1, "text_len": 255, "client_acts": ["on", "off", "brightness", "position", "open", "close", "stop", "tilt", "scene", "notify", "press", "option", "value", "preset"], "client_domains": ["light", "cover", "scene", "button", "input_button", "select", "input_select", "number", "input_number"],
    "source": "One table for the agent, the backend and the app (owner 13.11: a rule may change anything of Hauflo's own). HA entity services per domain (developers.home-assistant.io/docs/core/entity/*); the values' bounds come from the entity's own attributes (options, min / max / step, preset_modes, hvac_modes…), the canon's only when the entity says nothing. Never a lock, the alarm, a gate; a valve only closes (ownership, agent __init__ _protected). A pulse is a switch on for N s then off (a KNX push-button object driven by a switch); press / pulse / run restore nothing."},
  "schedule": {"moments": 8, "sun_offset_min": [-180, 180], "catch_up_s": 60, "horizon_days": 8, "events": ["sunrise", "sunset"],
    "source": "HA automations (time / sun triggers, one moment = one trigger, no «back»), KNX switching clocks (switching points, weekday programmes) and Loxone «Schaltuhr»: a moment fires once; a pair (on 07:00 / off 22:00) is two moments or two rules. A moment missed while HA was down is not caught up (HA does not either) — said in the log; a restart within catch_up_s still runs it."},
  "schedule_recipes": [
    {"id": "schedule_ventilation", "purpose": "fan", "at": {"times": ["07:00"], "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "actions": [{"do": "speed", "domain": "fan", "value": 60}, {"do": "press", "domain": "button"}],
      "source": "The owner's case 13.11: a supply unit's speed and its damper / valve change-over push-button by time. 60 % a day speed is a starting point (EN 16798-1 sizes the air flow); a second rule sets the night speed."},
    {"id": "sunset_light", "purpose": "light", "at": {"sun": [{"event": "sunset", "offset_min": 0}], "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "actions": [{"do": "on", "domain": "light"}],
      "source": "HA sun trigger / KNX astro clock: outdoor and entrance light at sunset."},
    {"id": "night_covers", "purpose": "cover", "at": {"sun": [{"event": "sunset", "offset_min": 15}], "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "actions": [{"do": "close", "domain": "cover"}],
      "source": "VDI 3813-2 / KNX astro blinds: shutters down a little after sunset (privacy, the night's heat loss)."},
    {"id": "morning_heating", "purpose": "comfort", "at": {"times": ["06:30"], "days": ["mon", "tue", "wed", "thu", "fri"]}, "actions": [{"do": "setpoint", "domain": "climate", "value": 21}],
      "source": "EN ISO 52120-1 (EN 15232) time programmes: comfort setpoint before the household gets up on working days; 21 °C is the EN 16798-1 category II winter comfort."},
    {"id": "night_setback", "purpose": "comfort", "at": {"times": ["23:00"], "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}, "actions": [{"do": "setpoint", "domain": "climate", "value": 18}],
      "source": "EN ISO 52120-1 night setback: about 3 K below comfort at night (18 °C)."}
  ],
  "recipes": [
    {"id": "heater_outdoor", "purpose": "heater", "input": "outdoor", "when": "below", "x": 5, "y": 2, "for_min": 10, "back_min": 10, "actions": [{"do": "on", "role": "heater"}], "back": "reverse", "interlock": "supply_fan"},
    {"id": "dew_point_airing", "purpose": "fan", "input": "derived:dew_point", "when": "above", "x": 14, "y": 1, "for_min": 10, "back_min": 15, "actions": [{"do": "on", "role": "fan"}], "back": "reverse"},
    {"id": "co2_ventilation", "purpose": "fan", "input": "co2", "when": "above", "x": 1000, "y": 150, "for_min": 5, "back_min": 10, "actions": [{"do": "speed", "role": "fan", "value": 70}], "back": "reverse"},
    {"id": "humidity_ventilation", "purpose": "fan", "input": "humidity", "when": "above", "x": 70, "y": 10, "for_min": 5, "back_min": 10, "actions": [{"do": "on", "role": "fan"}], "back": "reverse"},
    {"id": "frost_guard", "purpose": "frost", "input": "temperature", "when": "below", "x": 7, "y": 2, "for_min": 2, "back_min": 10, "actions": [{"do": "on", "role": "heater"}, {"do": "notify"}], "back": "reverse"},
    {"id": "floor_overheat", "purpose": "heater", "input": "floor_temperature", "when": "above", "x": 31, "y": 2, "for_min": 2, "back_min": 10, "actions": [{"do": "off", "role": "heater"}, {"do": "notify"}], "back": "reverse"},
    {"id": "leak_valve", "purpose": "leak", "input": "moisture", "when": "on", "for_min": 0, "back_min": 0, "actions": [{"do": "close", "role": "valve"}, {"do": "notify"}], "back": "nothing"},
    {"id": "window_heating", "purpose": "comfort", "input": "window", "when": "on", "for_min": 2, "back_min": 1, "actions": [{"do": "mode", "role": "thermostat", "value": "off"}], "back": "reverse"},
    {"id": "lux_covers", "purpose": "cover", "input": "illuminance", "when": "above", "x": 40000, "y": 10000, "for_min": 10, "back_min": 20, "actions": [{"do": "position", "role": "cover", "value": 30}], "back": "reverse"},
    {"id": "season", "purpose": "season", "input": "outdoor", "when": "below", "x": 8, "y": 0, "for_min": 0, "back_min": 0, "window": {"stat": "mean", "period": "day", "n": 5}, "outputs": {"suggest": true, "suggest_back": true, "auto": false}, "auto_allowed": true, "actions": [{"do": "season", "value": "heat"}], "back": "reverse",
      "source": "RU heating season: Government Decree No. 354 (06.05.2011) p. 5 — heating starts / ends after 5 days in a row with a daily mean outdoor temperature below / above +8 °C; SP 131.13330 (SNiP 23-01): the heating period is the days with a daily mean ≤ +8 °C. Both ways, 8 °C / 5 days kept."},
    {"id": "heat_wave", "purpose": "cover", "input": "outdoor", "when": "above", "x": 30, "y": 2, "for_min": 0, "back_min": 0, "window": {"stat": "max", "period": "day", "n": 2}, "outputs": {"suggest": true, "suggest_back": false, "auto": false}, "auto_allowed": true, "only_if": [{"type": "time", "after": "12:00", "before": "17:00"}], "actions": [{"do": "position", "role": "cover", "value": 0}], "back": "nothing",
      "source": "DWD «heißer Tag»: daily max ≥ 30 °C; a heat wave proper (KNMI) needs 3 such days — 2 kept as an early comfort hint. VDI 3813-2 sun protection: shade the sunny side in the afternoon (the integrator picks the covers)."},
    {"id": "frost_trace_heating", "purpose": "frost", "input": "outdoor", "when": "below", "x": 3, "y": 2, "for_min": 0, "back_min": 0, "window": {"stat": "min", "period": "hour", "n": 1}, "outputs": {"suggest": true, "suggest_back": false, "auto": false}, "auto_allowed": true, "actions": [{"do": "on", "role": "trace_heater"}], "back": "reverse",
      "source": "Roof / gutter de-icing and pipe trace heating practice (nVent Raychem, DEVI): ambient-sensing control switches on at about +3 °C (range 0…+5 °C). The owner's +2 °C is below that: +3 °C used; off again above +5 °C (Y = 2)."},
    {"id": "bath_humidity", "purpose": "notify", "input": "humidity", "room": "bathroom", "when": "above", "x": 70, "y": 5, "for_min": 0, "back_min": 0, "window": {"stat": "mean", "period": "hour", "n": 3}, "outputs": {"suggest": false, "suggest_back": false, "auto": true}, "auto_allowed": true, "actions": [{"do": "notify"}], "back": "nothing",
      "source": "Building physics (UBA «Schimmelleitfaden», IEA Annex 14): room air above 70 % RH for long favours mould; 3 hourly means in a row are longer than a shower's peak. 70 % / 3 h kept."},
    {"id": "co2_bedroom_night", "purpose": "fan", "input": "co2", "room": "bedroom", "when": "above", "x": 1000, "y": 100, "for_min": 0, "back_min": 0, "window": {"stat": "mean", "period": "hour", "n": 1}, "outputs": {"suggest": true, "suggest_back": false, "auto": false}, "auto_allowed": true, "only_if": [{"type": "time", "after": "22:00", "before": "07:00"}], "actions": [{"do": "speed", "role": "fan", "value": 70}], "back": "reverse",
      "source": "EN 16798-1 / Pettenkofer: indoor CO₂ ≤ 1000 ppm is good air (category II ≈ 800 ppm above outdoor). 1000 ppm kept."},
    {"id": "setpoint_unreached", "purpose": "notify", "input": "thermostat_gap", "when": "above", "x": 1, "y": 0.5, "for_min": 120, "back_min": 30, "only_if": [{"type": "heating", "entity": "input"}], "actions": [{"do": "notify"}], "back": "nothing",
      "source": "EN 15500-1 room controllers: control accuracy about 1 K; a radiator room heats up in 1–2 h. 1 K short for 2 h while the thermostat heats (HA hvac_action «heating»: its valve is open) = too little heat. Floor heating is slower: raise the time."},
    {"id": "pump_runtime", "purpose": "notify", "input": "pump", "when": "above", "x": 16, "y": 0, "for_min": 0, "back_min": 0, "window": {"stat": "sum", "period": "day", "n": 1}, "outputs": {"suggest": false, "suggest_back": false, "auto": true}, "auto_allowed": true, "actions": [{"do": "notify"}], "back": "nothing",
      "source": "No standard: a pump's / boiler's daily run time is the house's own (a heating circulator may run all day in winter). 16 h a day is a starting point — the integrator sets the norm."},
    {"id": "energy_day", "purpose": "notify", "input": "energy", "unit": "kWh", "when": "above", "x": 20, "y": 0, "for_min": 0, "back_min": 0, "window": {"stat": "sum", "period": "day", "n": 1}, "outputs": {"suggest": false, "suggest_back": false, "auto": true}, "auto_allowed": true, "actions": [{"do": "notify"}], "back": "nothing",
      "source": "No standard: BDEW — an average household uses ~3,500 kWh a year (≈ 10 kWh a day); 20 kWh a day (about twice that) is a starting point — the integrator sets the house's norm."}
  ],
  "links": [
    {"id": "silent_sensor", "to": "rule_hints", "hints": ["mon_room_sensor_stale", "mon_room_air_stale", "mon_weather_stale"],
      "source": "BACnet (ASHRAE 135) Reliability: a silent sensor is a sensor fault. Already made by the rule hints («stale»: HA templates on last_reported, 2–6 h) — not duplicated as a value rule."}
  ],
  "bus_reads": {"delay_s": 3, "delay_bounds_s": [1, 30], "rules": 50, "triggers": 16, "reads": 32, "name_len": 80, "reads_per_min": 120, "log_size": 50, "log_out": 20,
    "ga_bits": {"3": [5, 3, 8], "2": [5, 11], "1": [16]},
    "source": "Р65: a KNX device may answer a read (R) yet never send its state by itself (T off, or the firmware keeps it inside: one mode bit rewrites several valves). Read its status objects 2–3 s after a command reaches the bus — time for the device to settle (HA KNX service knx.read). reads_per_min caps the bus load (a TP line carries ~50 telegrams/s; reads are bursts, not a stream)."}
}
