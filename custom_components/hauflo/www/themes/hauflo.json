{
 "name": "Hauflo Atelier",
 "about": "The one Hauflo theme: HA's theme variables (ha: common + dark + light, injected by theme.py into Home Assistant's themes) and the cards' design tokens (cards: --hf-<name>, declared by the cards on every card and on the page). Only Hauflo makes themes; a user picks light or dark.",
 "notes": {
  "ha.common.ha-tab-indicator-color": "The tabs: no grey track, the active tab gets Hauflo's own mark (hauflo-cards.js).",
  "ha.dark": "Graphite (dark) and paper (light): glass with an edge highlight, deep soft shadows, light as colour.",
  "ha.dark.eh-mode": "Read by the v5 cards: a view set to a fixed theme wins over the phone's mode.",
  "ha.dark.lovelace-background": "The warm glow low in the corner, fixed: the header bar and the page are one surface (designer review 25.10)."
 },
