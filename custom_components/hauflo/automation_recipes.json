{
  "version": 1,
  "_doc": "Client recipes of «Настройки → Автоматизации» (docs/automations-recipes.md). DATA only: recipes.py resolves them against the house's devices, automations.validate() has the last word. Params: $name in a value, -$name for a minus, {name} in a text.",
  "limits": {"per_rule_rooms": 20, "per_rule_devices": 6, "max_recipes": 40},
  "matchers": {
    "bedroom": "спальн|bedroom|master",
    "hall": "коридор|холл|прихож|hall|corridor|entrance|lobby",
    "living": "гостин|living|lounge|salon",
    "bath": "ванн|санузел|bath|wc|shower",
    "outdoor": "улиц|наруж|outdoor|outside|terrace|терраса"
  },
  "alarm_src": {
    "android": {"ru": "будильник {phone}, за {lead} мин", "en": "alarm of {phone}, {lead} min before"},
    "iphone": {"ru": "будильник iPhone («Команды»)", "en": "iPhone alarm (Shortcuts)"}
  },
  "groups": {
    "sun": {"ru": "Солнце", "en": "Sun"},
    "wake": {"ru": "Подъём", "en": "Wake-up"},
    "night": {"ru": "Ночь", "en": "Night"},
    "away": {"ru": "Уход и приход", "en": "Leaving and arriving"},
    "air": {"ru": "Воздух", "en": "Air"}
  },
  "recipes": [
    {"id": "sunset_covers", "group": "sun", "icon": "mdi:blinds",
     "title": {"ru": "Закрывать шторы на закате", "en": "Close the blinds at sunset"},
     "sub": {"ru": "Каждый день · {rooms}", "en": "Every day · {rooms}"},
     "basis": "Sun starter with an offset: Apple Home (sunset), Google Home routines (sun events), SmartThings (sunset ± min). Default: at sunset.",
     "params": {"off": {"type": "int", "default": 0, "min": -120, "max": 120, "unit": "min", "label": {"ru": "Сдвиг от заката", "en": "Offset from sunset"}}},
     "when": {"event": "sunset", "offset": "$off"},
     "actions": [{"do": "room_covers", "each": "cover_rooms", "cover": "close"}]},
    {"id": "sunrise_covers", "group": "sun", "icon": "mdi:blinds-open",
     "title": {"ru": "Открывать шторы на рассвете (кроме спальни)", "en": "Open the blinds at sunrise (not the bedroom)"},
     "sub": {"ru": "Каждый день · {rooms}", "en": "Every day · {rooms}"},
     "basis": "Sun starter, as above (Apple Home, Google Home, Homey). The bedroom is skipped: a sunrise that wakes people is the commonest complaint; the bedroom has the wake-up recipe.",
     "params": {"off": {"type": "int", "default": 30, "min": -120, "max": 120, "unit": "min", "label": {"ru": "Сдвиг от рассвета", "en": "Offset from sunrise"}}},
     "when": {"event": "sunrise", "offset": "$off"},
     "actions": [{"do": "room_covers", "each": "cover_rooms", "skip": "bedroom", "cover": "open"}]},
    {"id": "sunset_lights", "group": "sun", "icon": "mdi:lightbulb-on-outline",
     "title": {"ru": "Вечерний свет в гостиной на закате", "en": "Evening light in the living room at sunset"},
     "sub": {"ru": "Если кто-то дома · {rooms} · {b} %", "en": "If someone is home · {rooms} · {b} %"},
     "basis": "Apple Home «turn on the lights at sunset when someone is home», Google Home sun starter, SmartThings «after sunset». 15 min before sunset: the light is already dim by then. Brightness 60 %: a dimmed evening light (platform scene presets «Relax»/«Evening» 50–70 %).",
     "needs": ["people"],
     "params": {"off": {"type": "int", "default": -15, "min": -120, "max": 120, "unit": "min", "label": {"ru": "Сдвиг от заката", "en": "Offset from sunset"}},
                "b": {"type": "int", "default": 60, "min": 1, "max": 100, "unit": "%", "label": {"ru": "Яркость", "en": "Brightness"}}},
     "when": {"event": "sunset", "offset": "$off"},
     "only_if": [{"if": "home"}],
     "actions": [{"do": "on", "each": "light", "match": "living", "value": "$b"}]},
    {"id": "wake_covers", "group": "wake", "icon": "mdi:blinds-open",
     "title": {"ru": "Открывать шторы в спальне по будильнику", "en": "Open the bedroom blinds with the alarm"},
     "sub": {"ru": "{rooms} · {src}", "en": "{rooms} · {src}"},
     "basis": "Google Home «dismiss alarm» starter, Apple Shortcuts «alarm stopped», Homey/SmartThings Good Morning. Opens at the alarm itself.",
     "alarm": true,
     "params": {"lead": {"type": "int", "default": 0, "min": 0, "max": 60, "unit": "min", "label": {"ru": "За сколько минут до будильника (Android)", "en": "Minutes before the alarm (Android)"}}},
     "when": {"event": "alarm", "offset": "-$lead"},
     "actions": [{"do": "room_covers", "each": "cover_rooms", "match": "bedroom", "cover": "open"}]},
    {"id": "wake_light", "group": "wake", "icon": "mdi:alarm-light-outline",
     "title": {"ru": "Свет-будильник: плавно 0 → {b} %", "en": "Wake-up light: fade 0 → {b} %"},
     "sub": {"ru": "{rooms} · {src}", "en": "{rooms} · {src}"},
     "basis": "Google Home: lights brighten slowly before the alarm; Hue wake-up light: fade-in 10–30 min (the length is the user's). 25 % over 20 min: the light reaches the target at the alarm (Android: starts 20 min before).",
     "alarm": true,
     "params": {"lead": {"type": "int", "default": 20, "min": 0, "max": 60, "unit": "min", "label": {"ru": "За сколько минут до будильника (Android)", "en": "Minutes before the alarm (Android)"}},
                "m": {"type": "int", "default": 20, "min": 1, "max": 60, "unit": "min", "label": {"ru": "Сколько нарастает", "en": "Fade length"}},
                "b": {"type": "int", "default": 25, "min": 1, "max": 100, "unit": "%", "label": {"ru": "Яркость к концу", "en": "Final brightness"}}},
     "when": {"event": "alarm", "offset": "-$lead"},
     "actions": [{"do": "ramp", "each": "light", "match": "bedroom", "dim": true, "first": true, "value": "$b", "minutes": "$m"}]},
    {"id": "wake_climate", "group": "wake", "icon": "mdi:thermometer-chevron-up",
     "title": {"ru": "Согреть спальню к будильнику: {t} °C", "en": "Warm the bedroom for the alarm: {t} °C"},
     "sub": {"ru": "{rooms} · {src}", "en": "{rooms} · {src}"},
     "basis": "Nest/Ecobee «wake» comfort period; EN 16798-1 / DIN EN 12831 design room temperature 20 °C (living and bedrooms), +1 °C for a just-woken body. Starts 30 min before (Android).",
     "alarm": true,
     "params": {"lead": {"type": "int", "default": 30, "min": 0, "max": 60, "unit": "min", "label": {"ru": "За сколько минут до будильника (Android)", "en": "Minutes before the alarm (Android)"}},
                "t": {"type": "temp", "default": 21, "min": 16, "max": 26, "unit": "°C", "label": {"ru": "Температура", "en": "Temperature"}}},
     "when": {"event": "alarm", "offset": "-$lead"},
     "actions": [{"do": "temp", "each": "climate", "match": "bedroom", "value": "$t"}]},
    {"id": "night_off", "group": "night", "icon": "mdi:lightbulb-off-outline",
     "title": {"ru": "Выключать весь свет в {at}", "en": "Switch all lights off at {at}"},
     "sub": {"ru": "Каждый день · все комнаты", "en": "Every day · all rooms"},
     "basis": "Apple Home / Google Home «Bedtime» and SmartThings «Good Night»: all lights off at bedtime. 23:00: the common bedtime preset of the platforms.",
     "params": {"at": {"type": "time", "default": "23:00", "label": {"ru": "Время", "en": "Time"}}},
     "when": {"event": "time", "at": "$at"},
     "actions": [{"do": "room_off", "each": "rooms"}]},
    {"id": "corridor_night", "group": "night", "icon": "mdi:led-strip-variant",
     "title": {"ru": "Свет в коридоре ночью на {b} %", "en": "Hallway light at night, {b} %"},
     "sub": {"ru": "Каждый день в {at} · {rooms}", "en": "Every day at {at} · {rooms}"},
     "basis": "Night-light preset of Hue / Google Home «Night light»: 5–10 % is enough to find the way and not to wake.",
     "params": {"at": {"type": "time", "default": "23:00", "label": {"ru": "Время", "en": "Time"}},
                "b": {"type": "int", "default": 10, "min": 1, "max": 100, "unit": "%", "label": {"ru": "Яркость", "en": "Brightness"}}},
     "when": {"event": "time", "at": "$at"},
     "actions": [{"do": "on", "each": "light", "match": "hall", "dim": true, "first": true, "value": "$b"}]},
    {"id": "night_climate", "group": "night", "icon": "mdi:thermometer-low",
     "title": {"ru": "Ночью холоднее: {t} °C в {at}", "en": "Cooler at night: {t} °C at {at}"},
     "sub": {"ru": "Каждый день · {rooms}", "en": "Every day · {rooms}"},
     "basis": "US DOE Energy Saver: 68 °F (20 °C) awake, setback 7–10 °F for sleep or away; Sleep Foundation bedroom 60–67 °F (15.6–19.4 °C). 18 °C is inside both.",
     "params": {"at": {"type": "time", "default": "22:30", "label": {"ru": "Время", "en": "Time"}},
                "t": {"type": "temp", "default": 18, "min": 14, "max": 22, "unit": "°C", "label": {"ru": "Ночью", "en": "At night"}}},
     "when": {"event": "time", "at": "$at"},
     "actions": [{"do": "temp", "each": "climate", "match": "bedroom", "value": "$t"}]},
    {"id": "morning_climate", "group": "wake", "icon": "mdi:thermometer",
     "title": {"ru": "Утром тепло: {t} °C в {at}", "en": "Warm in the morning: {t} °C at {at}"},
     "sub": {"ru": "Будни · {rooms}", "en": "Weekdays · {rooms}"},
     "basis": "US DOE Energy Saver: 68 °F (20 °C) when awake and at home; +1 °C comfort start (Nest/Ecobee «Wake» period).",
     "days": ["mon", "tue", "wed", "thu", "fri"],
     "params": {"at": {"type": "time", "default": "06:30", "label": {"ru": "Время", "en": "Time"}},
                "t": {"type": "temp", "default": 21, "min": 16, "max": 26, "unit": "°C", "label": {"ru": "Температура", "en": "Temperature"}}},
     "when": {"event": "time", "at": "$at"},
     "actions": [{"do": "temp", "each": "climate", "value": "$t"}]},
    {"id": "bath_morning", "group": "wake", "icon": "mdi:shower-head",
     "title": {"ru": "Ванная тёплая к утру: {t} °C в {at}", "en": "Warm bathroom for the morning: {t} °C at {at}"},
     "sub": {"ru": "Каждый день · {rooms}", "en": "Every day · {rooms}"},
     "basis": "DIN EN 12831 national annex (DE): design room temperature of a bathroom 24 °C (living rooms 20 °C). Floor-heating thermostats: the thermostat's own limits are kept.",
     "params": {"at": {"type": "time", "default": "06:00", "label": {"ru": "Время", "en": "Time"}},
                "t": {"type": "temp", "default": 24, "min": 18, "max": 28, "unit": "°C", "label": {"ru": "Температура", "en": "Temperature"}}},
     "when": {"event": "time", "at": "$at"},
     "actions": [{"do": "temp", "each": "climate", "match": "bath", "value": "$t"}]},
    {"id": "away_off", "group": "away", "icon": "mdi:lightbulb-off-outline",
     "title": {"ru": "Все ушли — выключить весь свет", "en": "Everyone left — all lights off"},
     "sub": {"ru": "Когда уходит последний · все комнаты", "en": "When the last one leaves · all rooms"},
     "basis": "Apple Home «last person leaves», Google Home «Away» / Homey «last person leaves», SmartThings «Goodbye».",
     "needs": ["people"],
     "when": {"event": "presence", "to": "away"},
     "actions": [{"do": "set", "domain": "light", "cmd": "off", "all": true}]},
    {"id": "away_climate", "group": "away", "icon": "mdi:home-thermometer-outline",
     "title": {"ru": "Все ушли — экономный нагрев {t} °C", "en": "Everyone left — eco heating {t} °C"},
     "sub": {"ru": "Когда уходит последний · {rooms}", "en": "When the last one leaves · {rooms}"},
     "basis": "Google Nest «Eco when away» (Eco heating setpoint, user range 40–70 °F); US DOE: setback 7–10 °F from 68 °F = 14.5–16.5 °C. 16 °C: the upper edge, no cold walls. Summer: the integrator's cooling logic is not touched.",
     "needs": ["people"],
     "params": {"t": {"type": "temp", "default": 16, "min": 10, "max": 20, "unit": "°C", "label": {"ru": "Пока никого нет", "en": "While away"}}},
     "when": {"event": "presence", "to": "away"},
     "actions": [{"do": "temp", "each": "climate", "value": "$t"}]},
    {"id": "away_covers", "group": "away", "icon": "mdi:blinds",
     "title": {"ru": "Все ушли — закрыть шторы", "en": "Everyone left — close the blinds"},
     "sub": {"ru": "Когда уходит последний · {rooms}", "en": "When the last one leaves · {rooms}"},
     "basis": "Apple Home / SmartThings «Goodbye» scenes: blinds closed (privacy, sun protection while away).",
     "needs": ["people"],
     "when": {"event": "presence", "to": "away"},
     "actions": [{"do": "room_covers", "each": "cover_rooms", "cover": "close"}]},
    {"id": "home_climate", "group": "away", "icon": "mdi:home-thermometer",
     "title": {"ru": "Кто-то пришёл — комфорт {t} °C", "en": "Someone came home — comfort {t} °C"},
     "sub": {"ru": "Когда приходит первый · {rooms}", "en": "When the first one arrives · {rooms}"},
     "basis": "Nest/Ecobee/SmartThings «I'm back»: comfort setpoint. US DOE and EN 16798-1: 20 °C at home.",
     "needs": ["people"],
     "params": {"t": {"type": "temp", "default": 20, "min": 16, "max": 26, "unit": "°C", "label": {"ru": "Когда дома", "en": "At home"}}},
     "when": {"event": "presence", "to": "home"},
     "actions": [{"do": "temp", "each": "climate", "value": "$t"}]},
    {"id": "home_lights_dark", "group": "away", "icon": "mdi:home-lightbulb-outline",
     "title": {"ru": "Пришли в темноте — свет в коридоре {b} %", "en": "Home after dark — hallway light {b} %"},
     "sub": {"ru": "Когда приходит первый, если темно · {rooms}", "en": "When the first one arrives, if dark · {rooms}"},
     "basis": "Apple Home «when I arrive, turn on the lights — only after sunset» (Apple Support, Home automations).",
     "needs": ["people"],
     "params": {"b": {"type": "int", "default": 60, "min": 1, "max": 100, "unit": "%", "label": {"ru": "Яркость", "en": "Brightness"}}},
     "when": {"event": "presence", "to": "home"},
     "only_if": [{"if": "dark"}],
     "actions": [{"do": "on", "each": "light", "match": "hall", "first": true, "value": "$b"}]},
    {"id": "co2_fan_on", "group": "air", "icon": "mdi:molecule-co2",
     "title": {"ru": "CO₂ выше {x} ppm — включить вентиляцию", "en": "CO₂ above {x} ppm — fan on"},
     "sub": {"ru": "{rooms} · держится {for} мин · выключение — отдельное правило", "en": "{rooms} · for {for} min · switching off is a separate rule"},
     "basis": "EN 16798-1 / Pettenkofer: ≤ 1000 ppm is good indoor air. Pair with «CO₂ ниже … — выключить»: a rule fires once, the fan would stay on.",
     "params": {"x": {"type": "int", "default": 1000, "min": 400, "max": 5000, "unit": "ppm", "label": {"ru": "Порог", "en": "Threshold"}},
                "for": {"type": "int", "default": 5, "min": 0, "max": 240, "unit": "min", "label": {"ru": "Держится", "en": "For"}}},
     "when": {"event": "value", "sensors": {"kind": "carbon_dioxide", "with": "fan"}, "op": "above", "x": "$x", "for_min": "$for"},
     "actions": [{"do": "on", "each": "fan", "in": "@room"}]},
    {"id": "co2_fan_off", "group": "air", "icon": "mdi:molecule-co2",
     "title": {"ru": "CO₂ ниже {x} ppm — выключить вентиляцию", "en": "CO₂ below {x} ppm — fan off"},
     "sub": {"ru": "{rooms} · держится {for} мин", "en": "{rooms} · for {for} min"},
     "basis": "Hysteresis pair of the rule above: ≈ 800 ppm (EN 16798-1 category II, ~400 ppm above outdoor) so the fan does not flap.",
     "params": {"x": {"type": "int", "default": 800, "min": 400, "max": 5000, "unit": "ppm", "label": {"ru": "Порог", "en": "Threshold"}},
                "for": {"type": "int", "default": 10, "min": 0, "max": 240, "unit": "min", "label": {"ru": "Держится", "en": "For"}}},
     "when": {"event": "value", "sensors": {"kind": "carbon_dioxide", "with": "fan"}, "op": "below", "x": "$x", "for_min": "$for"},
     "actions": [{"do": "off", "each": "fan", "in": "@room"}]},
    {"id": "bath_humidity_on", "group": "air", "icon": "mdi:water-percent",
     "title": {"ru": "В ванной влажность выше {x} % — вытяжка", "en": "Bathroom humidity above {x} % — extractor on"},
     "sub": {"ru": "{rooms} · держится {for} мин · выключение — отдельное правило", "en": "{rooms} · for {for} min · switching off is a separate rule"},
     "basis": "Homey/SmartThings «humidity above → fan». UBA «Schimmelleitfaden»: comfort 40–60 % RH, mould risk above 70 %; 65 % starts early.",
     "params": {"x": {"type": "int", "default": 65, "min": 30, "max": 95, "unit": "%", "label": {"ru": "Порог", "en": "Threshold"}},
                "for": {"type": "int", "default": 3, "min": 0, "max": 240, "unit": "min", "label": {"ru": "Держится", "en": "For"}}},
     "when": {"event": "value", "sensors": {"kind": "humidity", "match": "bath", "with": "fan"}, "op": "above", "x": "$x", "for_min": "$for"},
     "actions": [{"do": "on", "each": "fan", "in": "@room"}]},
    {"id": "bath_humidity_off", "group": "air", "icon": "mdi:water-percent",
     "title": {"ru": "В ванной влажность ниже {x} % — вытяжку выключить", "en": "Bathroom humidity below {x} % — extractor off"},
     "sub": {"ru": "{rooms} · держится {for} мин", "en": "{rooms} · for {for} min"},
     "basis": "Hysteresis pair of the rule above: 55 % is inside the 40–60 % comfort band (UBA).",
     "params": {"x": {"type": "int", "default": 55, "min": 30, "max": 95, "unit": "%", "label": {"ru": "Порог", "en": "Threshold"}},
                "for": {"type": "int", "default": 5, "min": 0, "max": 240, "unit": "min", "label": {"ru": "Держится", "en": "For"}}},
     "when": {"event": "value", "sensors": {"kind": "humidity", "match": "bath", "with": "fan"}, "op": "below", "x": "$x", "for_min": "$for"},
     "actions": [{"do": "off", "each": "fan", "in": "@room"}]}
  ]
}
