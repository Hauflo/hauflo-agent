{
  "about": "Room pictures by name: the picture a room tile shows until the room has its own photo (Home Assistant area picture). Source of truth; backend/src/ha/roomPictures.json and frontend/src/lib/roomPictures.json are its copies (their tests compare them). Each type: `match` regexes (RU+EN, case-insensitive, tested on the room name; the first type that matches wins — utility first, then living rooms, so «кухня-гостиная» is a living room and «гостевая спальня» a guest room), `icon`, `files` — three webp files in www/rooms (served at /hauflo_static/rooms/<file>), `auto` — true: a room of this type shows its first picture without being asked (utility rooms, owner 12.11); false: the pictures are offered, the client / integrator chooses (living rooms). A name no type matches gets the `fallback` type's choices and no picture of its own.",
  "base": "/hauflo_static/rooms/",
  "fallback": "generic",
  "types": [
    {"id": "boiler", "icon": "mdi:home-thermometer", "match": ["котел", "бойлерн", "теплов(ой|ая)\\s+пункт", "boiler", "furnace", "heating\\s*room"], "files": ["boiler-1.webp", "boiler-2.webp", "boiler-3.webp"], "auto": true},
    {"id": "water", "icon": "mdi:water-alert", "match": ["водоузел", "узел\\s+ввода", "протеч", "водоснабж", "water\\s*(room|supply|node|inlet)", "leak"], "files": ["water-1.webp", "water-2.webp", "water-3.webp"], "auto": true},
    {"id": "electrical", "icon": "mdi:flash", "match": ["щитов", "электрощит", "электрическ(ий|ая)\\s+щит", "распредел", "electric(al)?\\s*(room|panel|board)", "switch\\s*board", "fuse\\s*(box|room)", "breaker"], "files": ["electrical-1.webp", "electrical-2.webp", "electrical-3.webp"], "auto": true},
    {"id": "server", "icon": "mdi:server-network", "match": ["сервер", "слаботоч", "коммутацион", "серверн", "server", "network\\s*(room|closet|cabinet)", "low[\\s-]*voltage", "comms?\\s*room", "\\brack\\b"], "files": ["server-1.webp", "server-2.webp", "server-3.webp"], "auto": true},
    {"id": "laundry", "icon": "mdi:washing-machine", "match": ["прачечн", "стиральн", "постирочн", "laundry", "washroom", "utility\\s*room"], "files": ["laundry-1.webp", "laundry-2.webp", "laundry-3.webp"], "auto": true},
    {"id": "storage", "icon": "mdi:warehouse", "match": ["кладов", "подсобн", "хозяйственн", "кладовка", "storage", "pantry", "store\\s*room"], "files": ["storage-1.webp", "storage-2.webp", "storage-3.webp"], "auto": true},
    {"id": "garage", "icon": "mdi:garage", "match": ["гараж", "паркинг", "машиноместо", "garage", "carport", "parking"], "files": ["garage-1.webp", "garage-2.webp", "garage-3.webp"], "auto": true},
    {"id": "pump", "icon": "mdi:water-pump", "match": ["насосн", "pump\\s*(room|house|station)", "pumping"], "files": ["pump-1.webp", "pump-2.webp", "pump-3.webp"], "auto": true},
    {"id": "ventilation", "icon": "mdi:fan", "match": ["вентиляц", "вентиляционн", "венткамер", "рекуперац", "ventilation", "hvac", "air\\s*handling", "mechanical\\s*room"], "files": ["ventilation-1.webp", "ventilation-2.webp", "ventilation-3.webp"], "auto": true},
    {"id": "pool", "icon": "mdi:pool", "match": ["бассейн", "технич\\S*\\s+помещени\\S*\\s+бассейн", "pool\\s*(plant|equipment|room|tech)", "swimming"], "files": ["pool-1.webp", "pool-2.webp", "pool-3.webp"], "auto": true},
    {"id": "guest", "icon": "mdi:bed-outline", "match": ["гостев", "guest\\s*(room|bedroom|suite)"], "files": ["guest-1.webp", "guest-2.webp", "guest-3.webp"], "auto": false},
    {"id": "kids", "icon": "mdi:teddy-bear", "match": ["детск", "nursery", "kids?\\s*(room|bedroom)", "children"], "files": ["kids-1.webp", "kids-2.webp", "kids-3.webp"], "auto": false},
    {"id": "living", "icon": "mdi:sofa", "match": ["гостин", "(^|[^а-яё])зал([^а-яё]|$)", "living", "lounge", "family\\s*room", "great\\s*room"], "files": ["living-1.webp", "living-2.webp", "living-3.webp"], "auto": false},
    {"id": "bedroom", "icon": "mdi:bed", "match": ["спальн", "master", "bedroom"], "files": ["bedroom-1.webp", "bedroom-2.webp", "bedroom-3.webp"], "auto": false},
    {"id": "kitchen", "icon": "mdi:silverware-fork-knife", "match": ["кухн", "kitchen"], "files": ["kitchen-1.webp", "kitchen-2.webp", "kitchen-3.webp"], "auto": false},
    {"id": "dining", "icon": "mdi:table-chair", "match": ["столов", "dining"], "files": ["dining-1.webp", "dining-2.webp", "dining-3.webp"], "auto": false},
    {"id": "bathroom", "icon": "mdi:shower", "match": ["ванн", "душев", "bathroom", "shower", "ensuite", "en-suite"], "files": ["bathroom-1.webp", "bathroom-2.webp", "bathroom-3.webp"], "auto": false},
    {"id": "toilet", "icon": "mdi:toilet", "match": ["санузел", "с/у", "туалет", "уборн", "\\bwc\\b", "toilet", "restroom", "powder\\s*room", "lavatory"], "files": ["toilet-1.webp", "toilet-2.webp", "toilet-3.webp"], "auto": false},
    {"id": "hallway", "icon": "mdi:door-open", "match": ["прихож", "холл", "тамбур", "entry", "entrance", "foyer", "\\bhall(way)?\\b", "vestibule", "mud\\s*room"], "files": ["hallway-1.webp", "hallway-2.webp", "hallway-3.webp"], "auto": false},
    {"id": "corridor", "icon": "mdi:walk", "match": ["коридор", "corridor", "passage", "landing"], "files": ["corridor-1.webp", "corridor-2.webp", "corridor-3.webp"], "auto": false},
    {"id": "office", "icon": "mdi:desk", "match": ["кабинет", "рабоч", "office", "study", "workroom"], "files": ["office-1.webp", "office-2.webp", "office-3.webp"], "auto": false},
    {"id": "closet", "icon": "mdi:hanger", "match": ["гардероб", "closet", "wardrobe", "dressing"], "files": ["closet-1.webp", "closet-2.webp", "closet-3.webp"], "auto": false},
    {"id": "terrace", "icon": "mdi:balcony", "match": ["террас", "балкон", "лодж", "веранд", "terrace", "balcony", "patio", "porch", "veranda", "deck"], "files": ["terrace-1.webp", "terrace-2.webp", "terrace-3.webp"], "auto": false},
    {"id": "stairs", "icon": "mdi:stairs", "match": ["лестниц", "stair"], "files": ["stairs-1.webp", "stairs-2.webp", "stairs-3.webp"], "auto": false},
    {"id": "gym", "icon": "mdi:dumbbell", "match": ["спортзал", "спорт", "тренаж", "фитнес", "\\bgym\\b", "fitness", "workout"], "files": ["gym-1.webp", "gym-2.webp", "gym-3.webp"], "auto": false},
    {"id": "sauna", "icon": "mdi:radiator", "match": ["саун", "(^|[^а-яё])бан", "хамам", "парн", "sauna", "steam", "hammam", "spa\\b"], "files": ["sauna-1.webp", "sauna-2.webp", "sauna-3.webp"], "auto": false},
    {"id": "cinema", "icon": "mdi:theater", "match": ["кинотеатр", "кинозал", "домашн\\S*\\s+кино", "cinema", "theat(er|re)", "media\\s*room"], "files": ["cinema-1.webp", "cinema-2.webp", "cinema-3.webp"], "auto": false},
    {"id": "garden", "icon": "mdi:tree", "match": ["двор", "(^|[^а-яё])сад", "участ", "беседк", "garden", "yard", "lawn", "gazebo", "outdoor", "exterior"], "files": ["garden-1.webp", "garden-2.webp", "garden-3.webp"], "auto": false},
    {"id": "generic", "icon": "mdi:home-outline", "match": [], "files": ["generic-1.webp", "generic-2.webp", "generic-3.webp"], "auto": false}
  ],
  "variant_labels": {"ru": "Вариант {n}", "en": "Option {n}"}
}
