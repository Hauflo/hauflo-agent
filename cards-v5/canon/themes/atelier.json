{
  "$schema": "./schema.json",
  "id": "atelier",
  "name": { "ru": "Ателье v2", "en": "Atelier v2" },
  "description": "Основная тема Hauflo: графит и бумага, стекло с кромкой и зерном, свет как цвет. Значения — theme.py + решения канона 29.10: ink-2 .72 и ink-3 .62 (сильнее, предложение штор), control-edge .50, «внимание» жёлтое (не янтарь нагрева), тёмный текст на ярком свете.",
  "modes": ["light", "dark"],
  "default_mode": "auto",
  "primitives": {
    "paper-0": "#FFFFFF", "paper-50": "#FBFAF8", "paper-100": "#EFECE6",
    "graphite-950": "#08090A", "graphite-900": "#141517", "graphite-850": "#1A1B1E",
    "ink-light": "#121212", "ink-dark": "#F4F2EE", "ink-warm": "#1B1712",
    "amber-400": "#FFB25C", "amber-600": "#E8901F", "amber-800": "#8C5200",
    "yellow-300": "#F2CF5B", "yellow-600": "#D9A400", "yellow-800": "#7A5A00",
    "ice-300": "#8DC2FF", "ice-600": "#3C82F0", "ice-800": "#1F5BB8",
    "mint-300": "#5CE0B4", "mint-600": "#14946C", "mint-800": "#0B6B4D",
    "red-400": "#FF5A5F", "red-600": "#E5383E", "red-800": "#B3261E",
    "teal-300": "#62D0DE", "teal-600": "#1E97AA", "teal-800": "#12707E",
    "violet-300": "#B4A4FF", "violet-600": "#7B61E0", "violet-800": "#5B44C4"
  },
  "tokens": {
    "font": "Onest, Inter, -apple-system, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif",
    "font-num": "Onest, Inter, -apple-system, 'SF Pro Display', sans-serif",
    "w-num": "250", "w-num-m": "300", "w-num-s": "350", "w-num-xs": "400",
    "fs-unit-k": "0.4",
    "r-card": "30px",
    "r-tile": "18px",
    "glow-strength": "0.3",
    "tint-strength": "0.22",
    "grain": "0.05",
    "grain-img": "url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5  0 0 0 0 .5  0 0 0 0 .5  0 0 0 1 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>\")"
  },
  "light": {
    "bg": "radial-gradient(90% 55% at 100% 100%, #F7EBDD 0%, #EFECE6 60%) fixed",
    "surface": "{paper-50}",
    "surface-glass": "linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,255,255,.72))",
    "surface-2": "rgba(18,18,18,.07)",
    "surface-sheet": "{paper-50}",
    "scrim": "rgba(20,16,10,.35)",
    "ink": "{ink-light}",
    "ink-2": "rgba(18,18,18,.72)",
    "ink-3": "rgba(18,18,18,.62)",
    "ink-on-fill": "#FFFFFF",
    "ink-on-bright": "{ink-warm}",
    "ink-on-media": "#FFFFFF",
    "media-shade": "rgba(0,0,0,.45)",
    "hair": "rgba(18,18,18,.08)",
    "line": "rgba(18,18,18,.42)",
    "control-edge": "rgba(18,18,18,.50)",
    "focus": "{mint-600}",
    "edge": "inset 0 1px 0 #ffffff, inset 0 0 0 1px rgba(18,18,18,.04)",
    "elev-1": "0 1px 1px rgba(40,30,20,.05), 0 10px 20px rgba(40,30,20,.06), 0 30px 60px rgba(40,30,20,.08)",
    "elev-2": "0 20px 60px rgba(40,30,20,.25)",
    "state-pending": "rgba(18,18,18,.62)",
    "alarm-screen": "radial-gradient(120% 80% at 50% 0%, #C8302F 0%, #8E1C1C 70%)",
    "warn-screen": "radial-gradient(120% 80% at 50% 0%, #8A6400 0%, #5A4100 70%)",
    "light-white": "#7FA2DE",
    "accent": "{mint-600}", "accent-text": "{mint-800}",
    "state-light": "{amber-600}", "state-light-text": "{amber-800}",
    "state-on": "{mint-600}", "state-on-text": "{mint-800}",
    "state-heat": "{amber-600}", "state-heat-text": "{amber-800}",
    "state-cool": "{ice-600}", "state-cool-text": "{ice-800}",
    "state-auto": "{mint-600}", "state-auto-text": "{mint-800}",
    "state-dry": "{teal-600}", "state-dry-text": "{teal-800}",
    "state-fan": "{violet-600}", "state-fan-text": "{violet-800}",
    "state-cover": "{ice-600}", "state-cover-text": "{ice-800}",
    "state-secure": "{mint-600}", "state-secure-text": "{mint-800}",
    "state-call": "{mint-600}", "state-call-text": "{mint-800}",
    "state-ok": "{mint-600}", "state-ok-text": "{mint-800}",
    "state-warn": "{yellow-600}", "state-warn-text": "{yellow-800}",
    "state-alarm": "{red-600}", "state-alarm-text": "{red-800}",
    "state-offline": "rgba(18,18,18,.62)", "state-offline-text": "rgba(18,18,18,.66)",
    "grain-blend": "multiply", "tile-glass": "rgba(255,255,255,.55)",
    "tile": "linear-gradient(180deg, #FFFFFF, rgba(255,255,255,.82))", "tile-elev": "0 1px 2px rgba(40,30,20,.06), 0 6px 14px rgba(40,30,20,.06)",
    "art-sky-1": "#DCE9FA", "art-sky-2": "#F1F6FD", "art-fabric": "#F1EEE9", "art-fabric-2": "#E7E3DC", "art-bar": "rgba(18,18,18,.22)", "art-frame": "rgba(31,91,184,.14)"
  },
  "dark": {
    "bg": "radial-gradient(90% 55% at 100% 100%, #1a1712 0%, #08090A 60%) fixed",
    "surface": "{graphite-900}",
    "surface-glass": "linear-gradient(180deg, rgba(255,255,255,.075), rgba(255,255,255,.03))",
    "surface-2": "rgba(255,255,255,.08)",
    "surface-sheet": "{graphite-850}",
    "scrim": "rgba(0,0,0,.55)",
    "ink": "{ink-dark}",
    "ink-2": "rgba(244,242,238,.72)",
    "ink-3": "rgba(244,242,238,.55)",
    "ink-on-fill": "{graphite-950}",
    "ink-on-bright": "{ink-warm}",
    "ink-on-media": "#FFFFFF",
    "media-shade": "rgba(0,0,0,.5)",
    "hair": "rgba(255,255,255,.08)",
    "line": "rgba(244,242,238,.40)",
    "control-edge": "rgba(244,242,238,.40)",
    "focus": "{mint-300}",
    "edge": "inset 0 1px 0 rgba(255,255,255,.10), inset 0 0 0 1px rgba(255,255,255,.05)",
    "elev-1": "0 1px 1px rgba(0,0,0,.4), 0 12px 24px rgba(0,0,0,.35), 0 40px 80px rgba(0,0,0,.45)",
    "elev-2": "0 20px 60px rgba(0,0,0,.6)",
    "state-pending": "rgba(244,242,238,.55)",
    "alarm-screen": "radial-gradient(120% 80% at 50% 0%, #B3261E 0%, #5E0F0F 70%)",
    "warn-screen": "radial-gradient(120% 80% at 50% 0%, #7A5A00 0%, #3A2B00 70%)",
    "light-white": "#D6E4FF",
    "accent": "{mint-300}",
    "state-light": "{amber-400}",
    "state-on": "{mint-300}",
    "state-heat": "{amber-400}",
    "state-cool": "{ice-300}",
    "state-auto": "{mint-300}",
    "state-dry": "{teal-300}",
    "state-fan": "{violet-300}",
    "state-cover": "{ice-300}",
    "state-secure": "{mint-300}",
    "state-call": "{mint-300}",
    "state-ok": "{mint-300}",
    "state-warn": "{yellow-300}",
    "state-alarm": "{red-400}",
    "state-offline": "rgba(244,242,238,.55)", "state-offline-text": "rgba(244,242,238,.72)",
    "grain": "0.07", "grain-blend": "overlay", "tile-glass": "rgba(255,255,255,.03)",
    "tile": "transparent", "tile-elev": "0 0 0 transparent",
    "art-sky-1": "#16294A", "art-sky-2": "#0F1A2C", "art-fabric": "#1E1F23", "art-fabric-2": "#26272C", "art-bar": "rgba(244,242,238,.22)", "art-frame": "rgba(141,194,255,.12)"
  },
  "icons": { "set": "hauflo", "fallback": "mdi" },
  "fonts": ["onest-cyrillic.woff2", "onest-latin.woff2"]
}
