{
  "$comment": "Hauflo theme schema — FINAL canon 29.10 (merges foundations + 5 domain proposals; old names → tokens-map.json). Every semantic token a card may use, its type and fallback. A theme sets any subset; the rest comes from `extends`, then the schema default, then the bridge (HA's own theme variables). Type sizes are rem: the loader writes them as calc(X * var(--hf-root, 1rem)), and --hf-root follows the OS text size (CANON.md §6). Checked by foundations/tools/themes.mjs; unknown keys fail the build.",
  "types": {
    "color": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|rgba?\\([0-9., ]+\\)|\\{[a-z0-9-]+\\})$",
    "paint": "^(none|#[0-9a-fA-F]{6}|rgba?\\([0-9., ]+\\)|(linear|radial)-gradient\\([#a-zA-Z0-9(),.% -]+\\)( fixed)?|\\{[a-z0-9-]+\\})$",
    "shadow": "^(none|((inset )?-?[0-9.]+(px)? -?[0-9.]+(px)?( -?[0-9.]+(px)?)?( -?[0-9.]+(px)?)? (#[0-9a-fA-F]{3,8}|rgba?\\([0-9., ]+\\))(, )?)+)$",
    "length": "^[0-9.]+(px|em|rem)$",
    "number": "^[0-9.]+$",
    "duration": "^[0-9]+ms$",
    "easing": "^cubic-bezier\\([0-9., -]+\\)$",
    "font": "^[A-Za-z0-9 ,'-]+$",
    "weight": "^([1-9]00|[1-9]50)$",
    "image": "^(none|url\\(.+\\))$",
    "blend": "^(normal|multiply|overlay|soft-light|screen)$"
  },
  "modeTokens": {
    "bg":            { "type": "paint",  "bridge": "var(--primary-background-color)", "doc": "фон страницы" },
    "surface":       { "type": "color",  "bridge": "var(--card-background-color)", "doc": "сплошная заливка карточки; от неё меряется контраст" },
    "surface-glass": { "type": "paint",  "bridge": "var(--ha-card-background, var(--card-background-color))", "doc": "стекло карточки (может быть градиентом)" },
    "surface-2":     { "type": "color",  "bridge": "var(--secondary-background-color)", "doc": "дорожки ползунков, тональные кнопки, чипы (было track / surface-sunken)" },
    "surface-sheet": { "type": "color",  "bridge": "var(--card-background-color)", "doc": "большой пульт, тост, активный сегмент (было sheet / surface-solid)" },
    "scrim":         { "type": "color",  "bridge": "rgba(0,0,0,.42)", "doc": "затемнение под пультом (было backdrop)" },
    "ink":           { "type": "color",  "bridge": "var(--primary-text-color)", "contrast": 7, "doc": "главный текст и цифры" },
    "ink-2":         { "type": "color",  "bridge": "var(--secondary-text-color)", "contrast": 4.5, "doc": "подписи, строки состояния" },
    "ink-3":         { "type": "color",  "bridge": "var(--disabled-text-color)", "contrast": 3, "doc": "третичное: шкала, оси, «нет данных»" },
    "ink-on-fill":   { "type": "color",  "bridge": "var(--text-primary-color, #fff)", "doc": "подпись на залитой кнопке; заливка кнопки = `state-*-text` (было ink-on-accent, ink-inverse, ink-on-attention/alarm/call)" },
    "ink-on-bright": { "type": "color",  "bridge": "#1B1712", "doc": "текст поверх яркой заливки цветом лампы (белый/холодный свет) — всегда тёмный (было ink-on-fill в свете)" },
    "ink-on-media":  { "type": "color",  "bridge": "#FFFFFF", "doc": "текст поверх фото, обложки, видео, аварийного экрана — всегда светлый с `media-shade` (было ink-photo, ink-on-media, on-alarm)" },
    "media-shade":   { "type": "color",  "bridge": "rgba(0,0,0,.45)", "doc": "затемнение под текстом на фото/видео" },
    "hair":          { "type": "color",  "bridge": "var(--divider-color)", "doc": "разделители (было hairline)" },
    "line":          { "type": "color",  "bridge": "var(--divider-color)", "doc": "декоративный контур, не для элементов управления" },
    "control-edge":  { "type": "color",  "bridge": "var(--secondary-text-color)", "contrast": 3, "doc": "граница контрола, узнаваемого по контуру (WCAG 1.4.11)" },
    "focus":         { "type": "color",  "bridge": "var(--primary-color)", "contrast": 3, "doc": "кольцо фокуса" },
    "edge":          { "type": "shadow", "bridge": "none", "doc": "блик кромки стекла (было surface-edge)" },
    "elev-1":        { "type": "shadow", "bridge": "var(--ha-card-box-shadow, none)", "doc": "тень карточки (было shadow-card, surface-shadow, deep)" },
    "elev-2":        { "type": "shadow", "bridge": "0 20px 60px rgba(0,0,0,.35)", "doc": "тень пульта, тоста (было shadow-sheet, shadow-float, lift)" },
    "state-pending": { "type": "color",  "bridge": "var(--secondary-text-color)", "contrast": 3, "doc": "команда ушла: кольцо «отправка…»" },
    "alarm-screen":  { "type": "paint",  "bridge": "#B3261E", "doc": "фон аварии на весь экран; текст — ink-on-media" },
    "warn-screen":   { "type": "paint",  "bridge": "#7A5A00", "doc": "фон «вход в охраняемый дом» (код + отсчёт); текст — ink-on-media" },
    "light-white":   { "type": "color",  "bridge": "#D6E4FF", "doc": "компонентный: заливка плитки белым/холодным светом (проверка ink-on-bright)" },
    "accent":        { "type": "color",  "bridge": "var(--primary-color)", "role": true, "doc": "бренд, переключатели, ссылки" },
    "state-light":   { "type": "color",  "bridge": "var(--state-light-active-color, var(--state-active-color))", "role": true, "doc": "свет, сцены света, свечение комнаты" },
    "state-on":      { "type": "color",  "bridge": "var(--state-switch-active-color, var(--state-active-color))", "role": true, "doc": "устройство включено / работает" },
    "state-heat":    { "type": "color",  "bridge": "var(--state-climate-heat-color)", "role": true, "doc": "нагрев" },
    "state-cool":    { "type": "color",  "bridge": "var(--state-climate-cool-color)", "role": true, "doc": "охлаждение; «ниже нормы» у датчиков (было state-info)" },
    "state-auto":    { "type": "color",  "bridge": "var(--state-climate-auto-color)", "role": true, "doc": "авто / диапазон" },
    "state-dry":     { "type": "color",  "bridge": "var(--state-climate-dry-color)", "role": true, "doc": "осушение, влажность" },
    "state-fan":     { "type": "color",  "bridge": "var(--state-climate-fan_only-color)", "role": true, "doc": "вентиляция, заслонки (было state-air)" },
    "state-cover":   { "type": "color",  "bridge": "var(--state-cover-active-color)", "role": true, "doc": "шторы открыты, дневной свет, сцены штор (было open, state-lit)" },
    "state-secure":  { "type": "color",  "bridge": "var(--state-lock-locked-color, var(--success-color))", "role": true, "doc": "заперто, под охраной" },
    "state-call":    { "type": "color",  "bridge": "var(--success-color)", "role": true, "doc": "звонок в дверь, «можно войти» (калитка открыта)" },
    "state-ok":      { "type": "color",  "bridge": "var(--success-color)", "role": true, "doc": "в норме — одна точка на карточку, не на каждой строке" },
    "state-warn":    { "type": "color",  "bridge": "var(--warning-color)", "role": true, "doc": "внимание, подсказка, подтверждение второго касания — жёлтый, не янтарь нагрева (было attention, hint)" },
    "state-alarm":   { "type": "color",  "bridge": "var(--error-color)", "role": true, "doc": "авария, тревога, REC (было fault, hazard, triggered, rec)" },
    "state-offline": { "type": "color",  "bridge": "var(--disabled-text-color)", "role": true, "doc": "нет связи, нет данных (пунктирное кольцо), выключено (было nodata)" },
    "grain-blend":   { "type": "blend",  "bridge": "normal", "doc": "v2 · наложение зерна стекла (светлая multiply, тёмная overlay)" },
    "tile":          { "type": "paint",  "bridge": "var(--secondary-background-color)", "doc": "v2 · плитка внутри карточки: светлая — белая бумага над стеклом, тёмная — тон (владелец 03.11: серая плоская плитка = «грязно»)" },
    "tile-elev":     { "type": "shadow", "bridge": "none", "doc": "v2 · тень плитки: светлая — мягкий подъём бумаги, тёмная — нет" },
    "tile-glass":    { "type": "color",  "bridge": "var(--secondary-background-color)", "doc": "v2 · стекло плитки-окна под рисунком шторы" },
    "art-sky-1":     { "type": "color",  "bridge": "#DCE9FA", "doc": "v2 · окно: небо сверху (свет снаружи)" },
    "art-sky-2":     { "type": "color",  "bridge": "#F1F6FD", "doc": "v2 · окно: небо снизу" },
    "art-fabric":    { "type": "color",  "bridge": "#F1EEE9", "doc": "v2 · ткань шторы" },
    "art-fabric-2":  { "type": "color",  "bridge": "#E7E3DC", "doc": "v2 · складка / ламель" },
    "art-bar":       { "type": "color",  "bridge": "rgba(18,18,18,.22)", "doc": "v2 · утяжелитель, карниз" },
    "art-frame":     { "type": "color",  "bridge": "rgba(31,91,184,.14)", "doc": "v2 · рама и импост окна" }
  },
  "roleDerived": {
    "$comment": "Each role R gets R-text (readable on surface ≥ 4.5:1; also the fill of a filled button under ink-on-fill), R-tint (fill) and R-glow (halo). Set by the theme or derived.",
    "text": { "derive": "{R}", "contrast": 4.5 },
    "tint": { "derive": "color-mix(in srgb, var(--hf-{R}) calc(var(--hf-tint-strength) * 100%), transparent)" },
    "glow": { "derive": "color-mix(in srgb, var(--hf-{R}) calc(var(--hf-glow-strength) * 100%), transparent)" }
  },
  "pairs": [
    { "fg": "ink-on-fill", "bg": "*-text", "min": 4.5, "doc": "подпись на залитой кнопке любой роли" },
    { "fg": "ink-on-bright", "bg": "light-white", "min": 4.5, "doc": "тёмный текст на белом/холодном свете (свет, решение 29.10)" },
    { "fg": "ink-on-media", "bg": "alarm-screen", "min": 4.5, "doc": "текст аварийного экрана" },
    { "fg": "ink-on-media", "bg": "warn-screen", "min": 4.5, "doc": "текст экрана ввода кода" },
    { "fg": "ink", "bg": "surface-sheet", "min": 7, "doc": "текст пульта" }
  ],
  "tokens": {
    "root":        { "type": "length", "bridge": "var(--ha-font-size-l, 1rem)", "doc": "корень шкалы (1rem шкалы = 16 px). В HA корень документа 14 px, поэтому мост — 16-px ступень HA × её масштаб текста; вне HA — 1rem. Без моста вся шкала была на 12,5 % мельче своей же документации (15 px → 13,1)" },
    "font":        { "type": "font",   "bridge": "var(--ha-font-family-body, system-ui, sans-serif)" },
    "font-num":    { "type": "font",   "bridge": "var(--ha-font-family-body, system-ui, sans-serif)", "doc": "шрифт больших цифр" },
    "w-num":       { "type": "weight", "default": "300", "doc": "вес числа L/XL (пульт, панель)" },
    "w-num-m":     { "type": "weight", "default": "300", "doc": "v2 · вес числа M (48)" },
    "w-num-s":     { "type": "weight", "default": "350", "doc": "v2 · вес числа S (32): тонкий штрих на малом кегле пропадает" },
    "w-num-xs":    { "type": "weight", "default": "400", "doc": "v2 · вес числа XS (22)" },
    "fs-unit-k":   { "type": "number", "default": "0.4", "doc": "v2 · единица после числа = max(fs-unit-k × число, fs-xs), по верху прописных; на карточке «°», «°C» — в пульте" },
    "w-reg":       { "type": "weight", "default": "400" },
    "w-med":       { "type": "weight", "default": "500" },
    "w-strong":    { "type": "weight", "default": "600" },
    "fs-caps":     { "type": "length", "default": "0.6875rem", "doc": "11 px: только капс-метки" },
    "fs-xs":       { "type": "length", "default": "0.75rem",   "doc": "12 px: самый мелкий обычный текст" },
    "fs-s":        { "type": "length", "default": "0.8125rem", "doc": "13 px: строки состояния" },
    "fs-m":        { "type": "length", "default": "0.9375rem", "doc": "15 px: имена" },
    "fs-l":        { "type": "length", "default": "1.25rem",   "doc": "20 px: заголовок карточки L" },
    "fs-xl":       { "type": "length", "default": "1.75rem",   "doc": "28 px: заголовок страницы" },
    "fs-num-xs":   { "type": "length", "default": "1.375rem",  "doc": "22 px: число в XS" },
    "fs-num-s":    { "type": "length", "default": "2rem",      "doc": "32 px: число в S" },
    "fs-num-m":    { "type": "length", "default": "3rem",      "doc": "48 px: число в M" },
    "fs-num-l":    { "type": "length", "default": "4.75rem",   "doc": "76 px: число в L" },
    "fs-num-xl":   { "type": "length", "default": "6.5rem",    "doc": "104 px: число в пульте, киоск" },
    "caps-track":  { "type": "length", "default": "0.14em" },
    "sp-1": { "type": "length", "default": "4px" }, "sp-2": { "type": "length", "default": "8px" }, "sp-3": { "type": "length", "default": "12px" },
    "sp-4": { "type": "length", "default": "16px" }, "sp-5": { "type": "length", "default": "20px" }, "sp-6": { "type": "length", "default": "24px" },
    "sp-7": { "type": "length", "default": "32px" }, "sp-8": { "type": "length", "default": "40px" },
    "r-card":  { "type": "length", "bridge": "var(--ha-card-border-radius, 12px)" },
    "r-tile":  { "type": "length", "default": "22px", "doc": "S, обложки, кадры (было radius-media/art)" },
    "r-row":   { "type": "length", "default": "20px", "doc": "XS и строки списков" },
    "r-ctl":   { "type": "length", "default": "14px", "doc": "кнопки, сегменты (было button/control/item)" },
    "r-chip":  { "type": "length", "default": "11px", "doc": "чипы, бейджи, иконки-кружки (было badge/icon)" },
    "r-pill":  { "type": "length", "default": "999px" },
    "r-sheet": { "type": "length", "default": "28px", "doc": "верх листа пульта" },
    "hit":     { "type": "length", "default": "44px", "doc": "мин. зона касания" },
    "hit-l":   { "type": "length", "default": "64px", "doc": "полоса «Проведите», клавиатура кода" },
    "ctl-s":   { "type": "length", "default": "40px", "doc": "± в строке XS (вся строка — цель)" },
    "ctl":     { "type": "length", "default": "48px", "doc": "± в S/M/L" },
    "ctl-l":   { "type": "length", "default": "56px", "doc": "± в пульте" },
    "icon-s":  { "type": "length", "default": "18px" },
    "icon-m":  { "type": "length", "default": "22px" },
    "icon-l":  { "type": "length", "default": "28px" },
    "line-w":  { "type": "length", "default": "1px" },
    "focus-w": { "type": "length", "default": "2px" },
    "dur-fast": { "type": "duration", "default": "160ms" },
    "dur":      { "type": "duration", "default": "240ms" },
    "dur-slow": { "type": "duration", "default": "450ms" },
    "ease":     { "type": "easing",   "default": "cubic-bezier(.2,.8,.2,1)" },
    "tint-strength": { "type": "number", "default": "0.22" },
    "glow-strength": { "type": "number", "default": "0.5", "doc": "0 — без свечений" },
    "grain":         { "type": "number", "default": "0.05", "doc": "сила зерна стекла; 0 — без зерна" },
    "grain-img":     { "type": "image",  "default": "none", "doc": "v2 · текстура зерна (data-URI)" },
    "icon-stroke":   { "type": "number", "default": "1.6", "doc": "v2 · толщина линии иконок Hauflo в сетке 24" },
    "press":         { "type": "number", "default": "0.97", "doc": "масштаб при нажатии" },
    "dim":           { "type": "number", "default": "0.45", "doc": "приглушение ИКОНКИ при «нет связи» (текст не гасим)" },
    "font-scale":    { "type": "number", "default": "1", "doc": "множитель темы поверх системного размера текста" }
  },
  "theme": {
    "required": ["id", "name", "modes"],
    "keys": ["$schema", "id", "name", "description", "extends", "modes", "default_mode", "primitives", "tokens", "light", "dark", "icons", "fonts"]
  },
  "overlay": {
    "$comment": "An overlay (e.g. «Крупно») stacks on ANY theme and sets only mode-independent tokens + text_scale_min.",
    "keys": ["$schema", "id", "name", "description", "tokens", "text_scale_min"]
  }
}
